# ========== Seguridad: credenciales, llaves y tokens ==========
# Cualquier variante de .env (además de las listadas arriba)
.env.*
!.env.example
# Archivos que pueden contener tokens de npm/registros
.npmrc
.netrc
# Llaves y certificados privados
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
# Bases de datos locales
*.sqlite
*.sqlite3
*.db

# ========== Semillas con contraseñas en texto plano ==========
